# ────────────────────────────────────────────────────────────────────────────
# Busari — Environment Variables
# Copy this file to .env.local for local dev, and set these in your hosting
# provider's dashboard (Vercel/Netlify/etc) for production. Never commit the
# real .env.local — it should already be in .gitignore.
# ────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# ⚠️ SECRET — server-only. Never expose with NEXT_PUBLIC_ prefix.
# Bypasses Row Level Security — used by the admin panel and Midtrans webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Midtrans ──────────────────────────────────────────────────────────────
# Toggle this to switch the ENTIRE payment stack (Snap.js script, Snap API,
# key validation) between sandbox and production. Both the client key and
# server key below MUST match this setting (sandbox keys start with "SB-").
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# --- Sandbox (testing) ---
# Get from https://dashboard.sandbox.midtrans.com/settings/config_info
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx

# --- Production (live payments) ---
# Get from https://dashboard.midtrans.com/settings/config_info
# ⚠️ Only set NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=true once these are in place
# AND your webhook URL + domain are registered in the production dashboard.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxx
# ⚠️ SECRET — server-only. Never expose with NEXT_PUBLIC_ prefix.
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxx

# ── WhatsApp fallback checkout ──────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=6281932531119
